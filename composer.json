{
    "name": "1tomany/rich-bundle",
    "description": "Symfony bundle that provides easy scaffolding to build RICH applications",
    "license": "MIT",
    "type": "symfony-bundle",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/log": "^3.0",
        "symfony/form": "^7.2|^8.0|^8.1",
        "symfony/security-core": "^7.2|^8.0|^8.1",
        "symfony/serializer": "^7.2|^8.0|^8.1",
        "symfony/validator": "^7.2|^8.0|^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpdocumentor/reflection-docblock": "^5.2|^6.0",
        "phpstan/phpstan": "^2.1.55",
        "phpunit/phpunit": "^13.1.11",
        "symfony/framework-bundle": "^7.2|^8.0|^8.1",
        "symfony/maker-bundle": "^1.67"
    },
    "suggest": {
        "1tomany/data-uri-bundle": "Provides a decoder to convert data into a self-destroying file object",
        "symfony/maker-bundle": "Provides the make:rich-module command to scaffold the directory and file structure for a RICH module",
        "symfony/security-bundle": "Provides an autowired TokenStorageInterface to extract authenticated users"
    },
    "autoload": {
        "psr-4": {
            "OneToMany\\RichBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneToMany\\RichBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "stan": "phpstan",
        "test": "phpunit",
        "flat": [
            "@fix",
            "@stan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Vic Cherubini",
            "email": "vcherubini@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
